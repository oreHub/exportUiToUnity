{
  "manifestVersion": 5,
  "id": "local.uiexport.dev",
  "name": "UI Export",
  "version": "0.3.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "23.3.0" },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "uiexport.panel",
      "label": { "default": "UI Export" },
      "minimumSize": { "width": 240, "height": 200 },
      "maximumSize": { "width": 2000, "height": 4000 },
      "preferredDockedSize": { "width": 320, "height": 600 },
      "preferredFloatingSize": { "width": 380, "height": 680 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["chrome"] }
      ]
    }
  ],
  "icons": [
    { "width": 24, "height": 24, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
